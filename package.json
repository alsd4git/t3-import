{
  "name": "@alsdd/t3-import",
  "version": "0.1.6-alsd.1",
  "description": "Import and sync Codex, Claude Code, and OpenCode conversations into T3 Code",
  "keywords": [
    "t3code",
    "codex",
    "claude-code",
    "conversation",
    "importer",
    "cli",
    "tui",
    "opencode",
    "sync"
  ],
  "author": {
    "name": "CarlosGtrz",
    "url": "https://github.com/CarlosGtrz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alsd4git/t3-import.git"
  },
  "bugs": {
    "url": "https://github.com/alsd4git/t3-import/issues"
  },
  "homepage": "https://github.com/alsd4git/t3-import#readme",
  "type": "module",
  "bin": {
    "t3-import": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor/t3-v010",
    "vendor/t3-v011",
    "vendor/t3-v012",
    "vendor/t3-v013",
    "vendor/t3-v014",
    "vendor/t3-v015",
    "vendor/t3-v016",
    "README.md",
    "CHANGELOG.md",
    "assets/fork-demo.png",
    "assets/fork-demo.gif",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package:check": "node scripts/package-check.mjs",
    "release:ci": "node scripts/release.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "release:check": "npm publish --dry-run --access public",
    "compat:prepare": "node scripts/compatibility/prepare.mjs",
    "compat:schemas": "node scripts/compatibility/generate-schemas.mjs",
    "test:compatibility": "npm run compat:prepare && tsx scripts/compatibility/run.ts",
    "vendor:v2": "node scripts/v2/build-runtime.mjs",
    "compat:v2-schema": "node scripts/v2/generate-schema.mjs"
  },
  "engines": {
    "node": "^22.21.1 || >=24"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.0",
    "effect": "4.0.4",
    "effect-v011": "npm:effect@4.0.5",
    "env-paths": "^3.0.0",
    "ink": "^6.2.3",
    "react": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "esbuild": "0.28.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "contributors": [
    {
      "name": "Alessandro Digilio",
      "url": "https://github.com/alsd4git"
    }
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
